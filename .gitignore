!/.cargo/
!/.github/
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/LICENSE
!/README.md
!/CLAUDE.md
!/SKILL.md
!/crates/
!/xtask/
!/tests/
